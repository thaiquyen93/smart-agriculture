# =============================================================
# SMURF agent-core — Multi-Agent AI cho Track B: Smart Agriculture
# Copy file này thành .env để chạy local.
# Tài liệu đầy đủ: docs/agent-core/04-integration-guide.md
# =============================================================

# --- Kafka / Redpanda (dùng chung với các service khác, KHÔNG đổi) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TOPIC_RAW=topic_raw
TOPIC_P=topic_p
TOPIC_H=topic_h

# --- Topic agent-core tự phát ra ---
TOPIC_AGENT_EVENTS=topic_agent_events
TOPIC_PLANS=topic_plans
TOPIC_TASKS=topic_tasks
TOPIC_NOTIFICATIONS=topic_notifications
TOPIC_VERIFICATIONS=topic_verifications

# --- Provider LLM hiện hành: đổi 1 dòng này là đổi provider ---
# xem docs/agent-core/adr/ADR-001-llm-provider-strategy.md
LLM_PROFILE=local

# Profile: local (LM Studio — xem docs/agent-core/04-integration-guide.md §5)
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=qwen2.5-3b-instruct
LOCAL_LLM_API_KEY=lm-studio       # LM Studio bỏ qua giá trị này, nhưng SDK OpenAI bắt buộc có field
LOCAL_MAX_DISPATCH_ROUNDS=2
LOCAL_USE_NATIVE_TOOL_CALLING=false

# Profile: gemini (cắm sau — chỉ cần điền GEMINI_LLM_API_KEY và đổi LLM_PROFILE)
GEMINI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_LLM_API_KEY=
GEMINI_MAX_DISPATCH_ROUNDS=4
GEMINI_USE_NATIVE_TOOL_CALLING=true

# --- Dùng chung cho mọi profile ---
LLM_TEMPERATURE_DECISION=0.1      # cho call phân loại/quyết định (Router, Coordinator, Workers, Action)
LLM_TEMPERATURE_NARRATIVE=0.6     # chỉ cho call viết bản tin tiếng Việt (Narrative Agent)
LLM_TIMEOUT_SEC=120                # Demo M5.1/M4.6: đủ dư cho cold-start local model; xem scripts/run_demo_profile.py
AGENT_MAX_WORKERS=4

# --- Ngưỡng độ mới dữ liệu (freshness) ---
FRESHNESS_FRESH_SEC=60
FRESHNESS_STALE_SEC=600           # trên ngưỡng này -> OFFLINE

# --- Policy Gate (an toàn, tất định — KHÔNG do LLM quyết) ---
POLICY_MIN_TANK_LEVEL_PCT=20
POLICY_APPROVAL_THRESHOLD_LITERS=500
POLICY_MAX_VOLUME_LITERS=2000
POLICY_MAX_DURATION_MINUTES=120

# --- Lớp ML định lượng: baseline | fuzzy_branch (xem docs/agent-core/05-ml-interfaces.md) ---
MODEL_SOIL_FORECASTER=baseline
MODEL_WATER_DEMAND=baseline
MODEL_PUMP_HEALTH=baseline
MODEL_ANOMALY=baseline

# --- Service ---
AGENT_CORE_PORT=8100
