# Cấu hình kết nối MQTT (thay đổi Broker Host phù hợp với dịch vụ bạn đang dùng, ví dụ: io.adafruit.com, v.v...)
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883

# Thông tin từ ảnh
MQTT_USERNAME=SMURF
MQTT_PASSWORD=
MQTT_TOPIC=hackathon/smurf/test/telemetry
TEST_KEY= # Cập nhật toàn bộ key vào đây nếu cần thiết
